# ==============================================================================
# TrendKartz / Bazaarvilla Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# For local development with Firebase Emulator, set NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true.

# ------------------------------------------------------------------------------
# 1. Local Firebase Emulator Configuration (RECOMMENDED FOR DEVELOPMENT & TESTS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
USE_FIREBASE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ------------------------------------------------------------------------------
# 2. Client-Side Firebase Configuration (Public)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=dummy-api-key-for-emulator
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-trendkartz
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-trendkartz.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ------------------------------------------------------------------------------
# 3. Server-Side Firebase Admin Configuration (Private Secrets)
# In emulator mode, service account keys are NOT required when using demo-* project.
# In production, provide the service account credentials from Firebase Console.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-trendkartz
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway Configuration
# Use Test Mode keys (starting with rzp_test_) for development and testing.
# Never configure Live Mode keys (rzp_live_) in development or testing.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholderKey
RAZORPAY_KEY_ID=rzp_test_placeholderKey
RAZORPAY_KEY_SECRET=placeholderSecretForSignatureVerification
RAZORPAY_WEBHOOK_SECRET=placeholderWebhookSecretForHMACVerification
